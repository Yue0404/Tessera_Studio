{
  "name": "tessera-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "schema:generate": "node scripts/generate-project-validator.mjs",
    "schema:check": "node scripts/generate-project-validator.mjs --check",
    "dev": "pnpm --filter @tessera/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm schema:check && pnpm -r --if-present typecheck",
    "lint": "node scripts/check-domain-literals.mjs && eslint .",
    "format:check": "prettier --check --end-of-line auto .",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:runtime": "node scripts/run-runtime-benchmark.mjs",
    "benchmark:browser": "node scripts/run-browser-benchmark.mjs",
    "e2e": "playwright test",
    "e2e:production": "playwright test --config=playwright.production.config.ts",
    "e2e:pages": "playwright test --config=playwright.pages.config.ts",
    "pages:check": "node scripts/check-pages-artifact.mjs",
    "e2e:edge": "playwright test --config=playwright.cross-browser.config.ts --project=edge-system",
    "e2e:chrome": "playwright test --config=playwright.cross-browser.config.ts --project=chrome-system",
    "e2e:chromium": "playwright test --config=playwright.cross-browser.config.ts --project=chromium-playwright",
    "e2e:firefox": "playwright test --config=playwright.cross-browser.config.ts --project=firefox-playwright",
    "support:matrix": "node scripts/run-browser-support-matrix.mjs",
    "support:matrix:test": "node --test scripts/browser-support-matrix-result.test.mjs",
    "verify:civ6-extractor-contract": "node tools/civ6-extractor/scripts/verify-package-compatibility.mjs",
    "verify:civ6-extractor-real": "node tools/civ6-extractor/scripts/verify-package-compatibility.mjs --real",
    "inspect:civ6-installation": "node tools/civ6-extractor/scripts/inspect-installation.mjs",
    "inspect:civ6-catalog": "node tools/civ6-extractor/scripts/inspect-installation.mjs --catalog",
    "inspect:civ6-art": "node tools/civ6-extractor/scripts/inspect-installation.mjs --art",
    "release:check": "node scripts/check-release-evidence.mjs && node --test scripts/benchmark-profile.test.mjs scripts/release-evidence.test.mjs scripts/release-readiness.test.mjs scripts/line-ending.test.mjs scripts/release-runner.test.mjs",
    "release:ready": "node scripts/check-release-readiness.mjs",
    "release:verify": "node scripts/verify-release-candidate.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.5.3",
    "jsdom": "^29.0.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.0"
  }
}
