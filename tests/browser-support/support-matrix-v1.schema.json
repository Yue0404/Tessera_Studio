{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tessera-studio.local/schemas/support-matrix-v1.schema.json",
  "title": "Tessera Studio Browser Support Matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "generatedAt",
    "environment",
    "coverage",
    "runs",
    "previousMajor"
  ],
  "properties": {
    "profile": { "const": "support-matrix-v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "nodeVersion"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "nodeVersion": { "type": "string", "minLength": 1 }
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["flow", "specs"],
        "properties": {
          "flow": { "type": "string", "minLength": 1 },
          "specs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "status",
          "channel",
          "browserName",
          "browserVersion",
          "exitCode",
          "durationMs"
        ],
        "properties": {
          "target": {
            "enum": [
              "edge-system",
              "chrome-system",
              "chromium-playwright",
              "firefox-playwright"
            ]
          },
          "status": { "enum": ["passed", "failed", "unavailable"] },
          "channel": { "type": "string", "minLength": 1 },
          "browserName": { "type": ["string", "null"] },
          "browserVersion": { "type": ["string", "null"] },
          "exitCode": { "type": ["integer", "null"] },
          "durationMs": { "type": "number", "minimum": 0 },
          "reason": { "type": "string" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "status": { "const": "passed" } },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "browserName": { "type": "string", "minLength": 1 },
                "browserVersion": { "type": "string", "minLength": 1 },
                "exitCode": { "const": 0 }
              }
            }
          },
          {
            "if": {
              "properties": { "status": { "const": "unavailable" } },
              "required": ["status"]
            },
            "then": {
              "required": ["reason"],
              "properties": {
                "browserName": { "type": "null" },
                "browserVersion": { "type": "null" },
                "exitCode": { "type": "null" },
                "reason": { "type": "string", "minLength": 1 }
              }
            }
          }
        ]
      }
    },
    "previousMajor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "automation"],
      "properties": {
        "status": { "const": "not-tested" },
        "reason": { "type": "string", "minLength": 1 },
        "automation": { "type": "string", "minLength": 1 }
      }
    }
  }
}
